# ParkWise Environment Configuration
# Copy this to .env and fill in your values

# ========================================
# Network RPC URLs
# ========================================

# Polygon Mumbai Testnet
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Local node
LOCAL_RPC_URL=http://127.0.0.1:8545

# ========================================
# Blockchain Configuration
# ========================================

# Private key for deployment (NEVER commit real keys!)
PRIVATE_KEY=your_private_key_here

# Contract addresses (filled after deployment)
CONTRACT_ADDRESS=
ECOTOKEN_ADDRESS=

# Network to use
NETWORK=mumbai

# ========================================
# Block Explorer API Keys
# ========================================

# Polygonscan API key (for verification)
POLYGONSCAN_API_KEY=

# Etherscan API key (for Sepolia verification)
ETHERSCAN_API_KEY=

# ========================================
# Database Configuration
# ========================================

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/parkwise

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parkwise
DB_USER=postgres
DB_PASSWORD=password

# ========================================
# AI Pipeline Configuration
# ========================================

# AI service URL
AI_SERVICE_URL=http://localhost:8001

# Model paths
MODEL_PATH=./models

# ========================================
# Web3 Provider for Sync Service
# ========================================

# WebSocket provider for event listening
WEB3_PROVIDER=wss://polygon-mumbai.g.alchemy.com/v2/your-api-key
# WEB3_PROVIDER=ws://localhost:8545

# ========================================
# IPFS Configuration
# ========================================

# IPFS gateway for evidence storage
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API=https://api.pinata.cloud/pinning/pinFileToIPFS

# Pinata API keys
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ========================================
# Service Configuration
# ========================================

# Sync service configuration
SYNC_BATCH_SIZE=1000
SYNC_POLL_INTERVAL=2
SYNC_START_BLOCK=0

# AI pipeline configuration
AI_LOOKBACK_DAYS=90
AI_MIN_DONATIONS=1

# ========================================
# Monitoring & Logging
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Sentry DSN for error tracking
SENTRY_DSN=

# ========================================
# Security
# ========================================

# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_here

# API rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ========================================
# Feature Flags
# ========================================

# Enable/disable features
ENABLE_BLOCKCHAIN_SYNC=true
ENABLE_AI_PIPELINE=true
ENABLE_REAL_TIME_DASHBOARD=true
ENABLE_ECO_TOKENS=true
